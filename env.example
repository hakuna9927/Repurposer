# Google Gemini API Key (required for summarization and content generation)
GOOGLE_API_KEY=your_gemini_key_here

# Whisper model size (base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# FFmpeg binary path (optional, if not on system PATH)
# FFMPEG_BIN=/path/to/ffmpeg/bin
# Windows example: FFMPEG_BIN=C:/Users/YourName/Downloads/ffmpeg/bin

